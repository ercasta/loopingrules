@prefix lr:      <https://loopingrules.org/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:lr:package> a lr:Package ;
  dcterms:title "arch-check" ;
  lr:version "0.1.0" ;
  dcterms:description "Checks the layering of LoopingRules' own engine: a module may only import from its layer or the layers below. Run it with lr check." ;
  dcterms:creator "Antonio Castaldo D'Ursi" ;
  dcterms:license "MIT" ;
  # the only commands it runs: list the package, and grep each module's relative imports
  lr:mayRun "ls -1 '{}'" , "grep -oE '^ *from [.][a-z_]+ import' '{}'" .
