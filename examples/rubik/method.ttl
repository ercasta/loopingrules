alg:cp_none_0 a rk:AlgorithmStep ; rdf:first rmv:U ; rdf:rest alg:cp_none_1 .
alg:cp_none_1 a rk:AlgorithmStep ; rdf:first rmv:R ; rdf:rest alg:cp_none_2 .
alg:cp_none_2 a rk:AlgorithmStep ; rdf:first rmv:Ui ; rdf:rest alg:cp_none_3 .
alg:cp_none_3 a rk:AlgorithmStep ; rdf:first rmv:Li ; rdf:rest alg:cp_none_4 .
alg:cp_none_4 a rk:AlgorithmStep ; rdf:first rmv:U ; rdf:rest alg:cp_none_5 .
alg:cp_none_5 a rk:AlgorithmStep ; rdf:first rmv:Ri ; rdf:rest alg:cp_none_6 .
alg:cp_none_6 a rk:AlgorithmStep ; rdf:first rmv:Ui ; rdf:rest alg:cp_none_7 .
alg:cp_none_7 a rk:AlgorithmStep ; rdf:first rmv:L ; rdf:rest rdf:nil .

# --- stage 7: yellow corners oriented ----------------------------------------
case:co_twist a rk:Case ; rk:stage stage:CornersOriented ; rdfs:label "the front-right corner's yellow isn't on top" ;
  rk:need need:co_twist_0 ;
  rk:algorithm alg:co_twist_0 .
need:co_twist_0 rk:at rpos:U9 ; rk:unlike rpos:U5 .
alg:co_twist_0 a rk:AlgorithmStep ; rdf:first rmv:Ri ; rdf:rest alg:co_twist_1 .
alg:co_twist_1 a rk:AlgorithmStep ; rdf:first rmv:Di ; rdf:rest alg:co_twist_2 .
alg:co_twist_2 a rk:AlgorithmStep ; rdf:first rmv:R ; rdf:rest alg:co_twist_3 .
alg:co_twist_3 a rk:AlgorithmStep ; rdf:first rmv:D ; rdf:rest rdf:nil .
case:co_next a rk:Case ; rk:stage stage:CornersOriented ; rdfs:label "it is, but another corner's isn't: bring that one round" ;
  rk:need need:co_next_0, need:co_next_1 ;
  rk:algorithm alg:co_next_0 .
need:co_next_0 rk:at rpos:U9 ; rk:like rpos:U5 .
need:co_next_1 rk:at rpos:U1, rpos:U3, rpos:U7 ; rk:unlike rpos:U5 .
alg:co_next_0 a rk:AlgorithmStep ; rdf:first rmv:U ; rdf:rest rdf:nil .
case:co_align a rk:Case ; rk:stage stage:CornersOriented ; rdfs:label "the top is yellow but turned: turn it into place" ;
  rk:need need:co_align_0, need:co_align_1, need:co_align_2, need:co_align_3, need:co_align_4 ;
  rk:algorithm alg:co_align_0 .
need:co_align_0 rk:at rpos:U1 ; rk:like rpos:U5 .
need:co_align_1 rk:at rpos:U3 ; rk:like rpos:U5 .
need:co_align_2 rk:at rpos:U7 ; rk:like rpos:U5 .
need:co_align_3 rk:at rpos:U9 ; rk:like rpos:U5 .
need:co_align_4 rk:at rpos:F2 ; rk:unlike rpos:F5 .
alg:co_align_0 a rk:AlgorithmStep ; rdf:first rmv:U ; rdf:rest rdf:nil .
