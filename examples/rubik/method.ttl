# --- stage 4: yellow cross ---------------------------------------------------
proc:sexy a pl:Procedure ; rdfs:label "sexy move" ; pl:steps steps:sexy_0 .
steps:sexy_0 rdf:first rmv:R ; rdf:rest steps:sexy_1 .
steps:sexy_1 rdf:first rmv:U ; rdf:rest steps:sexy_2 .
steps:sexy_2 rdf:first rmv:Ri ; rdf:rest steps:sexy_3 .
steps:sexy_3 rdf:first rmv:Ui ; rdf:rest rdf:nil .
proc:yellowCross a pl:Procedure ; rdfs:label "front, sexy move, front back" ; pl:steps steps:yellowCross_0 .
steps:yellowCross_0 rdf:first rmv:F ; rdf:rest steps:yellowCross_1 .
steps:yellowCross_1 rdf:first proc:sexy ; rdf:rest steps:yellowCross_2 .
steps:yellowCross_2 rdf:first rmv:Fi ; rdf:rest rdf:nil .
need:yc_dot_0 rk:at rpos:U2 ; rk:unlike rpos:U5 .
need:yc_dot_1 rk:at rpos:U4 ; rk:unlike rpos:U5 .
need:yc_dot_2 rk:at rpos:U6 ; rk:unlike rpos:U5 .
need:yc_dot_3 rk:at rpos:U8 ; rk:unlike rpos:U5 .
case:yc_dot a pl:Case ; pl:stage stage:YellowCross ; rdfs:label "no yellow edge on top" ; pl:when need:yc_dot_0, need:yc_dot_1, need:yc_dot_2, need:yc_dot_3 ; pl:do proc:yellowCross .
need:yc_l_0 rk:at rpos:U2 ; rk:like rpos:U5 .
need:yc_l_1 rk:at rpos:U4 ; rk:like rpos:U5 .
need:yc_l_2 rk:at rpos:U6 ; rk:unlike rpos:U5 .
need:yc_l_3 rk:at rpos:U8 ; rk:unlike rpos:U5 .
case:yc_l a pl:Case ; pl:stage stage:YellowCross ; rdfs:label "an L: yellow edges at the back and on the left" ; pl:when need:yc_l_0, need:yc_l_1, need:yc_l_2, need:yc_l_3 ; pl:do proc:yellowCross .
need:yc_line_0 rk:at rpos:U4 ; rk:like rpos:U5 .
need:yc_line_1 rk:at rpos:U6 ; rk:like rpos:U5 .
need:yc_line_2 rk:at rpos:U2 ; rk:unlike rpos:U5 .
case:yc_line a pl:Case ; pl:stage stage:YellowCross ; rdfs:label "a line: yellow edges on the left and on the right" ; pl:when need:yc_line_0, need:yc_line_1, need:yc_line_2 ; pl:do proc:yellowCross .

# --- stage 5: yellow edges ---------------------------------------------------
proc:sune a pl:Procedure ; rdfs:label "sune" ; pl:steps steps:sune_0 .
steps:sune_0 rdf:first rmv:R ; rdf:rest steps:sune_1 .
steps:sune_1 rdf:first rmv:U ; rdf:rest steps:sune_2 .
steps:sune_2 rdf:first rmv:Ri ; rdf:rest steps:sune_3 .
steps:sune_3 rdf:first rmv:U ; rdf:rest steps:sune_4 .
steps:sune_4 rdf:first rmv:R ; rdf:rest steps:sune_5 .
steps:sune_5 rdf:first rmv:U2 ; rdf:rest steps:sune_6 .
steps:sune_6 rdf:first rmv:Ri ; rdf:rest rdf:nil .
proc:swapEdges a pl:Procedure ; rdfs:label "sune, then turn the top: swaps the front and left edges" ; pl:steps steps:swapEdges_0 .
steps:swapEdges_0 rdf:first proc:sune ; rdf:rest steps:swapEdges_1 .
steps:swapEdges_1 rdf:first rmv:U ; rdf:rest rdf:nil .
need:ye_adjacent_0 rk:at rpos:B2 ; rk:like rpos:B5 .
need:ye_adjacent_1 rk:at rpos:R2 ; rk:like rpos:R5 .
need:ye_adjacent_2 rk:at rpos:F2 ; rk:unlike rpos:F5 .
case:ye_adjacent a pl:Case ; pl:stage stage:YellowEdges ; rdfs:label "the back and right edges match, the front one doesn't" ; pl:when need:ye_adjacent_0, need:ye_adjacent_1, need:ye_adjacent_2 ; pl:do proc:swapEdges .
need:ye_opposite_0 rk:at rpos:F2 ; rk:like rpos:F5 .
need:ye_opposite_1 rk:at rpos:B2 ; rk:like rpos:B5 .
need:ye_opposite_2 rk:at rpos:R2 ; rk:unlike rpos:R5 .
case:ye_opposite a pl:Case ; pl:stage stage:YellowEdges ; rdfs:label "the front and back edges match, the right one doesn't" ; pl:when need:ye_opposite_0, need:ye_opposite_1, need:ye_opposite_2 ; pl:do proc:swapEdges .
proc:turnTop a pl:Procedure ; rdfs:label "turn the top" ; pl:steps steps:turnTop_0 .
steps:turnTop_0 rdf:first rmv:U ; rdf:rest rdf:nil .
case:ye_turn a pl:Case ; pl:stage stage:YellowEdges ; rdfs:label "fewer than two edges match: turn the top" ; pl:priority -1 ; pl:do proc:turnTop .

# --- stage 6: yellow corners placed ------------------------------------------
proc:cycleCorners a pl:Procedure ; rdfs:label "cycle three corners, keeping the front-right one" ; pl:steps steps:cycleCorners_0 .
steps:cycleCorners_0 rdf:first rmv:U ; rdf:rest steps:cycleCorners_1 .
steps:cycleCorners_1 rdf:first rmv:R ; rdf:rest steps:cycleCorners_2 .
steps:cycleCorners_2 rdf:first rmv:Ui ; rdf:rest steps:cycleCorners_3 .
steps:cycleCorners_3 rdf:first rmv:Li ; rdf:rest steps:cycleCorners_4 .
steps:cycleCorners_4 rdf:first rmv:U ; rdf:rest steps:cycleCorners_5 .
steps:cycleCorners_5 rdf:first rmv:Ri ; rdf:rest steps:cycleCorners_6 .
steps:cycleCorners_6 rdf:first rmv:Ui ; rdf:rest steps:cycleCorners_7 .
steps:cycleCorners_7 rdf:first rmv:L ; rdf:rest rdf:nil .
need:cp_one_0 rk:at rpos:U9, rpos:F3, rpos:R1 ; rk:like rpos:U5 .
need:cp_one_1 rk:at rpos:U9, rpos:F3, rpos:R1 ; rk:like rpos:F5 .
need:cp_one_2 rk:at rpos:U9, rpos:F3, rpos:R1 ; rk:like rpos:R5 .
case:cp_one a pl:Case ; pl:stage stage:CornersPlaced ; rdfs:label "the front-right corner is in place, twisted or not" ; pl:when need:cp_one_0, need:cp_one_1, need:cp_one_2 ; pl:do proc:cycleCorners .
case:cp_none a pl:Case ; pl:stage stage:CornersPlaced ; rdfs:label "no corner is in place" ; pl:priority -1 ; pl:do proc:cycleCorners .

# --- stage 7: yellow corners oriented ----------------------------------------
proc:twistCorner a pl:Procedure ; rdfs:label "twist the front-right corner (R' D' R D)" ; pl:steps steps:twistCorner_0 .
steps:twistCorner_0 rdf:first rmv:Ri ; rdf:rest steps:twistCorner_1 .
steps:twistCorner_1 rdf:first rmv:Di ; rdf:rest steps:twistCorner_2 .
steps:twistCorner_2 rdf:first rmv:R ; rdf:rest steps:twistCorner_3 .
steps:twistCorner_3 rdf:first rmv:D ; rdf:rest rdf:nil .
need:untilYellowUp_0 rk:at rpos:U9 ; rk:like rpos:U5 .
step:untilYellowUp a pl:Until ; pl:until need:untilYellowUp_0 ; pl:do proc:twistCorner .
proc:orientOne a pl:Procedure ; rdfs:label "orient the front-right corner, then bring the next one" ; pl:steps steps:orientOne_0 .
steps:orientOne_0 rdf:first step:untilYellowUp ; rdf:rest steps:orientOne_1 .
steps:orientOne_1 rdf:first rmv:U ; rdf:rest rdf:nil .
step:fourCorners a pl:Repeat ; pl:times 4 ; pl:do proc:orientOne .
need:untilAligned_0 rk:at rpos:F2 ; rk:like rpos:F5 .
step:untilAligned a pl:Until ; pl:until need:untilAligned_0 ; pl:do proc:turnTop .
proc:orientCorners a pl:Procedure ; rdfs:label "orient the yellow corners" ; pl:steps steps:orientCorners_0 .
steps:orientCorners_0 rdf:first step:fourCorners ; rdf:rest steps:orientCorners_1 .
steps:orientCorners_1 rdf:first step:untilAligned ; rdf:rest rdf:nil .
case:co_all a pl:Case ; pl:stage stage:CornersOriented ; rdfs:label "orient every corner, then align the top" ; pl:do proc:orientCorners .
