@prefix lr:      <https://loopingrules.org/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:lr:package> a lr:Package ;
  dcterms:title "rubik" ;
  lr:version "0.1.0" ;
  dcterms:description "A Rubik's cube as triples: 54 facelet colours, turns as operations, commands on lr:in." ;
