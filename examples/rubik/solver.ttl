@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix lr:   <https://loopingrules.org/ns#> .
@prefix rk:   <https://example.org/rubik#> .
@prefix pl:   <https://loopingrules.org/planning#> .

# The solver: the cube's side of the planning pack (design D31; doc/rubik.md).
# - The method is knowledge (method.ttl): stages, cases and procedures, written as the
#   beginner method writes them, with white on D. The pack (layers/planning) follows it.
# - The pack never reads the cube. It asks, and this file answers:
#     pl:Check (a condition, in a view)  ->  rk:answer, all pending checks in one go
#     ?run pl:doing ?move                ->  rk:do turns the cube, and clears it
# - A view is a frame (geometry.ttl): one of the 4 ways to hold the cube with white
#   down. It maps the method's relative positions and moves to this cube's.

# [] a rk:Solve  ->  a run of the beginner method.
rk:solve a lr:Operation ; rdfs:label "start solving" ;
  lr:params "m" ;
  lr:where  """ ?m lr:channel lr:in ; a rk:Solve .
                rk:cube rk:plan rdf:nil .
                FILTER NOT EXISTS { ?run a pl:Run }
                ?method a pl:Method . """ ;
  lr:insert """ [] a pl:Run ; pl:method ?method .
                [] lr:channel lr:out ; a lr:Say ; lr:replyTo ?m ; lr:text "Solving." . """ ;
  lr:steps ( [ lr:where """ ?m ?p ?o . """ ; lr:delete """ ?m ?p ?o . """ ] ) .

# Answer every pending check at once (no parameters: one application). Each UNION
# branch starts from the check: a UNION outside it was evaluated for every condition
# in every view (~650 ms). A condition
# names relative positions (rk:at) and a relative centre, and says
#   rk:like   - some sticker at those positions has the centre's colour, or
#   rk:unlike - some sticker at those positions doesn't.
rk:answer a lr:Operation ; rdfs:label "look at the cube" ;
  lr:params "" ;
  lr:where  """ { ?k a pl:Check ; pl:condition ?need ; pl:view ?fr . FILTER NOT EXISTS { ?k pl:result ?any }
                  ?need rk:like ?ref . ?fr ?ref ?centre . ?centre rk:colour ?c .
                  BIND(EXISTS { ?need rk:at ?at . ?fr ?at ?p . ?p rk:colour ?c } AS ?r) }
                UNION
                { ?k a pl:Check ; pl:condition ?need ; pl:view ?fr . FILTER NOT EXISTS { ?k pl:result ?any }
                  ?need rk:unlike ?ref . ?fr ?ref ?centre . ?centre rk:colour ?c .
                  BIND(EXISTS { ?need rk:at ?at . ?fr ?at ?p . FILTER NOT EXISTS { ?p rk:colour ?c } } AS ?r) } """ ;
  lr:insert """ ?k pl:result ?r . """ .

# Carry out the pack's move: the run's view maps it to this cube, and the colours move
# as in rk:turn (model.ttl). pl:doing is cleared in the same application, so the pack
# never asks about a cube that hasn't turned yet.
rk:do a lr:Operation ; rdfs:label "make the move" ;
  lr:params "run mv" ;
  lr:where  """ ?run pl:doing ?x ; pl:view ?fr . ?fr ?x ?mv . ?mv a rk:Move .
                rk:cube rk:turns ?n . BIND(?n + 1 AS ?n2) """ ;
  lr:delete """ ?run pl:doing ?x . rk:cube rk:turns ?n . """ ;
  lr:insert """ rk:cube rk:turns ?n2 .
                [] a rk:Executed ; rk:move ?mv ; rk:seq ?n2 . """ ;
  lr:steps (
    [ lr:where  """ ?mv rk:face ?face .
                    ?map rk:of ?face .
                    { ?mv rk:dir rk:cw .  ?map rk:from ?f ; rk:to ?t . }
                    UNION
                    { ?mv rk:dir rk:ccw . ?map rk:from ?t ; rk:to ?f . }
                    ?f rk:colour ?c . """ ;
      lr:delete """ ?f rk:colour ?c . """ ;
      lr:insert """ ?t rk:colour ?c . """ ]
    [ lr:where  """ ?mv rk:twice true ; rk:face ?face .
                    ?map rk:of ?face ; rk:from ?f ; rk:to ?t .
                    ?f rk:colour ?c . """ ;
      lr:delete """ ?f rk:colour ?c . """ ;
      lr:insert """ ?t rk:colour ?c . """ ]
  ) .
